# Build artefacts
build/
dist/
*.spec
__pycache__/
*.pyc
*.pyo

# Generated by build scripts
icon.ico
icon.png
icon.icns
icon.iconset/

# Installer build outputs and intermediates
dist/Imaginify-Setup-*.exe
dist/Imaginify-*.pkg
dist/Imaginify-component.pkg
dist/_pkg_staging/
installer_macos/resources/LICENSE.txt

# Local environments
.venv/
venv/
env/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Claude Code - commit the .claude/ bundle, never the machine-local permission
# cache (it records approved commands verbatim, so it can hold secrets).
**/.claude/settings.local.json

# Tauri app icons are committed (the patterns above would otherwise hide them).
!tauri/src-tauri/icons/*
