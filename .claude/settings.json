{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .*)",
      "PowerShell(Remove-Item -Recurse -Force C:\\*)"
    ],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(find*)",
      "Bash(mkdir*)",
      "Bash(cp*)",
      "Bash(touch*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git tag*)",
      "Bash(git stash*)",
      "Bash(git restore*)",
      "Bash(git switch*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git ls-remote*)",
      "Bash(gh release view*)",
      "Bash(gh release list*)",
      "Bash(gh release download*)",
      "Bash(gh release create*)",
      "Bash(gh run*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow view*)",
      "Bash(gh workflow list*)",
      "Bash(.claude/scripts/codex_review.sh*)",
      "Bash(bash .claude/scripts/codex_review.sh*)",
      "Bash(python3 .claude/scripts/check_versions.py*)",
      "Bash(python3 .claude/scripts/verify_release.py*)",
      "Bash(.venv/bin/python -m pip*)",
      "Bash(.venv/bin/python imaginify.py*)",
      "Bash(python3 -m venv .venv*)",
      "Bash(python3 -m py_compile*)",
      "Bash(bash run_macos.sh*)",
      "Bash(bash build_macos.sh*)",
      "Bash(bash build_installer_macos.sh*)",
      "Bash(ruff*)",
      "Bash(shellcheck*)",
      "Bash(lipo*)",
      "Bash(shasum*)",
      "Bash(hdiutil verify*)",
      "Bash(hdiutil imageinfo*)",
      "Bash(pkgutil --expand*)",
      "Bash(pkgutil --payload-files*)",
      "Bash(codesign -dv*)",
      "Bash(codesign --verify*)",
      "PowerShell(Get-ChildItem*)",
      "PowerShell(Get-Content*)",
      "PowerShell(Select-String*)",
      "PowerShell(Test-Path*)",
      "PowerShell(New-Item*)",
      "PowerShell(python*)",
      "PowerShell(py *)",
      "PowerShell(.\\build_windows.bat*)",
      "PowerShell(.\\build_installer_windows.bat*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git tag*)",
      "PowerShell(git push*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git checkout*)",
      "Bash(mv*)",
      "Bash(rm *)",
      "Bash(gh repo*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(pip install*)",
      "Bash(python3 -m pip install*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(Invoke-RestMethod*)",
      "PowerShell(Invoke-WebRequest*)",
      "Read(**/.claude/memory/**)"
    ]
  }
}
