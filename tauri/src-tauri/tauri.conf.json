{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imaginify",
  "version": "2.0.0",
  "identifier": "com.jezweb.imaginify",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Imaginify",
        "width": 1240,
        "height": 840,
        "minWidth": 1020,
        "minHeight": 720,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "JezPress",
    "copyright": "Copyright (c) 2026 JezPress",
    "category": "Photography",
    "shortDescription": "Resize, crop, compress and convert images",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
